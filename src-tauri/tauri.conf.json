{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "ora",
  "version": "0.1.2",
  "identifier": "com.stratusadv.ora",
  "build": {
    "beforeDevCommand": "bun run dev",
    "devUrl": "http://localhost:1430",
    "beforeBuildCommand": "bun run build",
    "frontendDist": "../dist"
  },
  "app": {
    "enableGTKAppId": true,
    "security": {
      "csp": "default-src 'self'; connect-src 'self' ipc: http://ipc.localhost; img-src 'self' data:; style-src 'self' 'unsafe-inline'; font-src 'self'; script-src 'self'"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "category": "Productivity",
    "shortDescription": "Dictation into any app",
    "longDescription": "ora turns speech into text through the Stratus speech model and pastes it into whichever app has focus.",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "createUpdaterArtifacts": true,
    "linux": {
      "deb": {
        "depends": ["libasound2t64 | libasound2"]
      },
      "rpm": {
        "depends": ["alsa-lib"]
      }
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IEI0QzFCM0YyMzc2RjIyQTIKUldTaUltODM4clBCdEhUeVEzdVcwaVVldzYzWW03YVlCSkFSOTdLVUVPcll1d2lsSmE2ZzZXRzcK",
      "endpoints": [
        "https://github.com/stratusadv/ora/releases/latest/download/latest.json"
      ],
      "windows": {
        "installMode": "passive"
      }
    }
  }
}
